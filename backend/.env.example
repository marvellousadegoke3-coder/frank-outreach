# Railway Postgres connection string (same DB the dashboard reads from)
DATABASE_URL=postgres://user:password@host:5432/railway

# Port Railway injects automatically; default used for local dev
PORT=3000

# Comma-separated list of allowed CORS origins (e.g. your dashboard URL). Use * for all.
CORS_ORIGIN=*

# Optional: Claude API key. If set, inbound replies are classified for sentiment
# (positive / neutral / negative / unsubscribe / meeting_booked) via Claude.
# If unset, a naive keyword-based classifier is used instead.
ANTHROPIC_API_KEY=

# Optional: Reoon email verification API key. Used as a fallback when MX check
# alone isn't conclusive (catch-all domains, etc). If unset, only MX check runs.
REOON_API_KEY=

# Shared secret n8n must send as `x-webhook-secret` header when calling
# POST /webhook/inbound and POST /agent/run. Set this to something random
# and configure it in n8n.
WEBHOOK_SECRET=change-me

# Optional: SMTP creds for actually sending outreach emails from /agent/run.
# If any of these are unset, sends are logged (not actually sent) so the
# pipeline still runs end-to-end before a real mailbox is set up.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
