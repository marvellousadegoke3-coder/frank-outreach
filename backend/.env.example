# Railway Postgres connection string (same DB the dashboard reads from)
DATABASE_URL=postgres://user:password@host:5432/railway

# Port Railway injects automatically; default used for local dev
PORT=3000

# Comma-separated list of allowed CORS origins (e.g. your dashboard URL). Use * for all.
CORS_ORIGIN=*

# Optional: Claude API key. If set, inbound replies are classified for sentiment
# (positive / neutral / negative / unsubscribe / meeting_booked) via Claude.
# If unset, a naive keyword-based classifier is used instead.
ANTHROPIC_API_KEY=

# Optional: Reoon email verification API key. Used as a fallback when MX check
# alone isn't conclusive (catch-all domains, etc). If unset, only MX check runs.
REOON_API_KEY=

# Shared secret n8n must send as `x-webhook-secret` header when calling
# POST /webhook/inbound and POST /agent/run. Set this to something random
# and configure it in n8n.
WEBHOOK_SECRET=change-me

# Optional: Gmail API OAuth creds for actually sending outreach emails from
# /agent/run. Generate GOOGLE_REFRESH_TOKEN once with `node scripts/gmail-auth.js`
# (see README). If any of these three are unset, sends are logged (not
# actually sent) so the pipeline still runs end-to-end before OAuth is set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional: fallback "From" address used only if a lead's campaign has no
# from_inbox set. Should be an address/alias the authorized Gmail account
# can send as.
GOOGLE_SEND_AS=

# Optional: your first name, used in the email sign-off ("<name>, Frank
# Digitals"). If unset, emails sign off as just "Frank Digitals".
SENDER_FIRST_NAME=

# Lead discovery (POST /leads/source) uses OpenStreetMap's Overpass API for
# business search — free, no API key, no billing account. Nothing to set
# here for it.

# Optional for POST /leads/source. Hunter.io free tier = 25 domain searches
# PER MONTH TOTAL, shared across everything using this key — treated as
# scarce. If unset, /leads/source falls back entirely to pattern-guessed
# emails (owner@/firstname@/info@) verified via MX/Reoon.
HUNTER_API_KEY=

# Optional budget knobs for POST /leads/source (sane defaults if unset):
# how many query x city combos to run per call, how many businesses to
# check per call (Overpass results are free, but Hunter/verify calls per
# business aren't unbounded work), the search radius in meters around each
# city center, and how many Hunter domain searches to spend per call
# (capped further by live account quota).
OSM_QUERIES_PER_RUN=4
OSM_ELEMENTS_PER_RUN=25
OSM_RADIUS_METERS=12000
HUNTER_MAX_CALLS_PER_RUN=1

# Default daily_send_limit set on a campaign that /leads/source auto-creates
# when it sources a lead in a niche with no campaigns row at all yet. Keeps
# /leads/source and /agent/run fully hands-off for brand-new niches.
AUTO_CAMPAIGN_DAILY_SEND_LIMIT=20
